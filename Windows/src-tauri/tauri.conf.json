{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIUsage",
  "version": "0.13.0",
  "identifier": "com.aiusage.desktop.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIUsage",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "AIUsage",
    "shortDescription": "AI usage dashboard and local proxy manager",
    "longDescription": "AIUsage monitors AI subscriptions, local usage, and proxy tracks on Windows."
  }
}
